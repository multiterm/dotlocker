# pluto .env.example
#
# Pluto is a self-hosted, multi-tenant server that stores and serves encrypted
# env files for workspaces. The server only ever sees ciphertext; decryption
# happens client-side with the local .env.keys file.
#
# Copy this file to .env and fill in the values that apply to you. The pluto
# CLI does NOT auto-load .env files; values listed here are read directly via
# process.env or via your shell.

# -----------------------------------------------------------------------------
# Server-side variables (read by `pluto serve` — the host process)
# -----------------------------------------------------------------------------

# Filesystem root for the SQLite database and ciphertext files. Must be
# writable by the pluto process. In the published Docker image this is /data
# and is exposed as a VOLUME so the operator mounts persistent storage there.
PLUTO_DATA_DIR=/data

# HTTP listen port. 3000 is the default in both the Dockerfile and the CLI.
PORT=3000

# HTTP listen bind address. Use 0.0.0.0 to accept external connections (the
# Docker default) or 127.0.0.1 to bind only to localhost during local dev.
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Client-side variables (read by `pluto pull`, `pluto exec`, `pluto push`,
# `pluto status` — the workspace/agent process)
# -----------------------------------------------------------------------------

# Bearer token used to authenticate against the pluto server. NEVER commit a
# real token to source control. Mint with `pluto token create --org <org>
# --scope '<path>:<read|write>' --label <name>` on the server host.
#
# Tokens are also accepted via the --token CLI flag (takes precedence over the
# env var) or via interactive prompt. Storing the token in pluto.config.json
# is rejected by the loader — this env var is the canonical way to inject it.
PLUTO_TOKEN=

# Base URL of the pluto server, e.g. https://pluto.example.com or
# http://localhost:3000. Can also be set via the --server flag or in
# pluto.config.json's `server` field.
PLUTO_SERVER=

# Workspace identity. Each of these overrides the equivalent field in
# pluto.config.json. They can also be passed as CLI flags
# (--org, --service, --env).
PLUTO_ORG=
PLUTO_SERVICE=
PLUTO_ENV=
