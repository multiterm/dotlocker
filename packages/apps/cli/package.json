{
  "name": "@multiterm/pluto",
  "description": "Self-hosted, multi-tenant file server for syncing runtime-scoped repository files.",
  "version": "0.2.10",
  "type": "module",
  "bin": {
    "pluto": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "files",
    "sync",
    "server",
    "cli"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rune build",
    "test": "rune test",
    "typecheck": "rune typecheck",
    "lint": "rune lint",
    "format": "rune format"
  },
  "rune": {
    "extends": "../../../configs/rune.config.ts",
    "scripts": {
      "build": [
        "vite build -c configs/vite.config.ts",
        "rm -rf dist/webui",
        "cp -R ../webui/dist dist/webui"
      ]
    }
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "jiti": "^2.7.0",
    "postgres": "^3.4.9",
    "prompts": "^2.4.2",
    "yargs": "^17.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33",
    "@multiterm/pluto-client": "workspace:*",
    "@multiterm/pluto-server": "workspace:*",
    "@multiterm/pluto-shared": "workspace:*",
    "@multiterm/pluto-webui": "workspace:*"
  }
}
