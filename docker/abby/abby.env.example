# Copy to /vol/nvme/docker/pluto/abby.env on Abby and chmod 600.
# Never commit the populated file.
ABBY_BIND_IP=100.114.99.85
ABBY_DATA_ROOT=/vol/nvme/docker/pluto

POSTGRES_VERSION=16.8-alpine
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-long-random-value
DOTLOCKER_PREVIEW_DB=pluto_preview
DOTLOCKER_PREVIEW_USER=pluto_preview
DOTLOCKER_PREVIEW_PASSWORD=replace-with-long-random-value
DOTLOCKER_PRODUCTION_DB=pluto_prod
DOTLOCKER_PRODUCTION_USER=pluto_prod
DOTLOCKER_PRODUCTION_PASSWORD=replace-with-long-random-value

GARAGE_VERSION=v1.1.0
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=replace-with-64-hex-character-value
GARAGE_ADMIN_TOKEN=replace-with-long-random-value
GARAGE_METRICS_TOKEN=replace-with-long-random-value

# Required only when compose.application.yml is enabled.
DOTLOCKER_DATABASE_URL=postgres://pluto_prod:replace-with-url-encoded-password@dotlocker-postgres:5432/pluto_prod
DOTLOCKER_S3_ENDPOINT=http://dotlocker-garage:3900
DOTLOCKER_S3_REGION=garage
DOTLOCKER_S3_BUCKET=dotlocker-production
DOTLOCKER_S3_ACCESS_KEY=replace-after-garage-bootstrap
DOTLOCKER_S3_SECRET_KEY=replace-after-garage-bootstrap
DOTLOCKER_BOOTSTRAP_ORG=honeycluster
