# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim
ENV SANDBLOCKS_RUNTIME=preview
CMD ["node", "-e", "const url=process.env.SANDBLOCKS_SERVICE_PLUTO_URL;if(!url)throw new Error('SANDBLOCKS_SERVICE_PLUTO_URL is required');fetch(new URL('/v1/health',url),{signal:AbortSignal.timeout(30000)}).then(async r=>{if(!r.ok)throw new Error('health status '+r.status);const body=await r.json();if(body.ok!==true)throw new Error('invalid health response')}).catch(e=>{console.error(e);process.exit(1)})"]
